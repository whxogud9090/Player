# This .gitignore file should be placed at the root of your Unity project directory.

# Unity generated folders
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Unity generated assets/caches
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/Unity.VisualScripting.Generated/
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# Addressables generated files
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Studio / Rider / editors
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.DotSettings.user

# Generated symbols and temporary files
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db
*.tmp
*.bak
*.swp

# Build artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Blender backup imports
*.blend1
*.blend1.meta

# Test/crash generated files
sysinfo.txt
mono_crash.*
crashlytics-build.properties
InitTestScene*.unity*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
